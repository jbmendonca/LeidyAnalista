{
  "name": "painel-analise-leitura",
  "version": "0.1.0",
  "private": true,
  "description": "Painel de Análise de Leitura — II Ciclo do Compromisso Nacional Criança Alfabetizada",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:regression": "vitest run tests/regression",
    "test:e2e": "playwright test",
