# Banco de dados — corresponde ao docker-compose.yml
DATABASE_URL="postgresql://painel:painel_local_dev@localhost:5432/painel_leitura?schema=public"

# Sessão — gere um valor próprio: openssl rand -base64 48
SESSION_SECRET="troque-este-valor-por-um-segredo-de-pelo-menos-32-caracteres"

# Duração da sessão
SESSION_ABSOLUTE_HOURS="12"
SESSION_IDLE_MINUTES="60"

# Armazenamento dos arquivos importados.
# ATENÇÃO: este diretório contém dados nominais de estudantes.
# Aplique as mesmas restrições de acesso do banco de dados.
IMPORT_STORAGE_DIR="./storage/imports"

# Limite de tamanho do arquivo importado, em megabytes
IMPORT_MAX_FILE_SIZE_MB="20"

# Retenção do arquivo original, em dias (FR-038a).
# Findo o prazo, o arquivo é excluído automaticamente; hash, contagens e
# auditoria permanecem. Padrão técnico de 90 dias — confirme com a política
# de dados da rede.
IMPORT_FILE_RETENTION_DAYS="90"

# Atributo Secure do cookie de sessão.
#
# Em branco: o sistema decide pelo protocolo real da requisição — o que faz o
# login funcionar em HTTP na rede local (ex.: http://192.168.0.10:3000) sem
# quebrar em silêncio.
#
# Em produção, sirva atrás de TLS e defina como "true".
# SESSION_COOKIE_SECURE="true"

# Ambiente
NODE_ENV="development"
